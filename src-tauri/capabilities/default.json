{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "tray-popover"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "core:path:default",
    "dialog:default",
    "store:default",
    "notification:default",
    "fs:default",
    "updater:default",
    "process:default"
  ]
}
